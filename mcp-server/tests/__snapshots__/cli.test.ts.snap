exports[`status > prints connection, quotas, queue and campaigns 1`] = `
"Server:    running (v2.0.0)
Extension: connected (v2.0.0)
LinkedIn:  logged in
Mode:      Copilot (writes need approval)
Hours:     inside business hours

quota    hourly  daily
-------  ------  -------
invite   2/20    12/100
message  0/20    4/150
visit    5/50    30/500
search   1/50    40/1000

Queue:     1 pending
Campaigns: 1 active, 0 paused"
`;
