// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`--help > lists every command 1`] = `
"Usage: lit [options] [command]

LinkedIn Toolkit: drive your own logged-in Chrome through the toolkit
extension.
Start the server with \`lit serve --http\`, then every other command talks to it.

Options:
  -V, --version                      output the version number
  -h, --help                         display help for command

Commands:
  serve [options]                    Run the bridge and the MCP server. Add
                                     --http for the HTTP API.
  status [options]                   Show the extension connection, quotas,
                                     queue and campaigns.
  search [options] <keywords>        Search LinkedIn people.
  profile [options] <url>            Fetch one profile.
  engagers [options] <postUrl>       List people who liked or commented on a
                                     post.
  company [options] <url>            Fetch a company, and optionally its
                                     employees.
  invite [options] <url>             Send a connection invite (queued for
                                     approval in Copilot mode).
  message [options] <url>            Send a message to a first-degree
                                     connection.
  inbox [options]                    List inbox threads.
  queue [options] [action] [ids...]  Show the approval queue, or approve or
                                     reject items.
  campaign                           Create and control campaigns.
  sql [options] <query>              Query the local SQLite mirror (read-only,
                                     1,000 rows).
  export [options]                   Export a table from the local mirror to
                                     CSV.
  sync [options]                     Pull everything changed in the extension
                                     into the local mirror.
  config                             Read and change this server's local
                                     settings
                                     (~/.linkedin-toolkit/config.json).
  token <action>                     Manage the pairing token.
  research [options] <input>         Turn a CSV of rows into research packs.
  help [command]                     display help for command"
`;

