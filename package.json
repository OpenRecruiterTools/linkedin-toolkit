{
  "name": "linkedin-toolkit-monorepo",
  "private": true,
  "workspaces": [
    "extension",
    "mcp-server",
    "clients/node",
    "clients/n8n"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .js,.ts",
    "gen": "npm run gen -w mcp-server",
    "sequences": "node sequences/validate.mjs",
    "zip:extension": "node scripts/zip-extension.mjs",
    "test:python": "node scripts/python-check.mjs",
    "release:check": "npm run build && npm run gen && git diff --exit-code -- mcp-server/openapi.json mcp-server/tools.json && npm run lint && npm test && npm run test:python && npm run sequences && npm run sequences:bundle && git diff --exit-code -- extension/sequences && npm run zip:extension",
    "sequences:bundle": "node scripts/copy-sequences.mjs"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3"
  }
}
